<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="using:System"
        xmlns:animation="using:Avalonia.Animation"
        xmlns:local="using:THRM.Avalonia"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:icons="using:FluentIcons.Avalonia.Fluent"
        x:Class="THRM.Avalonia.MainWindow"
        Title="THRM"
        Width="960"
        Height="640"
        MinWidth="720"
        MinHeight="440"
        TransparencyLevelHint="Mica,None"
        TransparencyBackgroundFallback="{DynamicResource ApplicationPageBackgroundThemeBrush}"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <sys:TimeSpan x:Key="SplitViewPaneAnimationCloseDuration">00:00:00.167</sys:TimeSpan>

    <ControlTheme x:Key="THRMSettingsExpanderExpanderTheme"
                  TargetType="Expander">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="{DynamicResource SettingsExpanderMinHeight}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ExpanderContentBorderBrush}" />
      <Setter Property="BorderThickness" Value="{DynamicResource ExpanderContentDownBorderThickness}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
      <Setter Property="Template">
        <ControlTemplate>
          <StackPanel>
            <ToggleButton Name="ToggleButton"
                          MinHeight="{TemplateBinding MinHeight}"
                          IsEnabled="{TemplateBinding IsEnabled}"
                          IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                          Content="{TemplateBinding Header}"
                          Theme="{StaticResource SettingsExpanderToggleButtonStyle}" />

            <local:AnimatedContentClip Name="ExpanderContentClip"
                                       IsExpanded="{TemplateBinding IsExpanded}">
              <local:AnimatedContentClip.Transitions>
                <Transitions>
                  <DoubleTransition Property="RevealProgress"
                                    Duration="00:00:00.250"
                                    Easing="CubicEaseOut" />
                  <DoubleTransition Property="Opacity"
                                    Duration="00:00:00.200"
                                    Easing="CubicEaseOut" />
                </Transitions>
              </local:AnimatedContentClip.Transitions>
              <Border Name="ExpanderContent"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius, Converter={StaticResource BottomCornerRadiusFilterConverter}}"
                      BackgroundSizing="InnerBorderEdge">
                <ContentPresenter Name="PART_ContentPresenter"
                                  Margin="{TemplateBinding Padding}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Content="{TemplateBinding Content}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Border>
            </local:AnimatedContentClip>
          </StackPanel>
        </ControlTemplate>
      </Setter>

    </ControlTheme>

    <ControlTheme x:Key="THRMSettingsExpanderTheme"
                  TargetType="ui:FASettingsExpander"
                  BasedOn="{StaticResource {x:Type ui:FASettingsExpander}}">
      <Setter Property="Template">
        <ControlTemplate>
          <Expander Name="Expander"
                    Theme="{StaticResource THRMSettingsExpanderExpanderTheme}"
                    IsExpanded="{TemplateBinding IsExpanded, Mode=TwoWay}">
            <Expander.Header>
              <ui:FASettingsExpanderItem Content="{TemplateBinding Header}"
                                         ContentTemplate="{TemplateBinding HeaderTemplate}"
                                         Description="{TemplateBinding Description}"
                                         IsClickEnabled="{TemplateBinding IsClickEnabled}"
                                         IconSource="{TemplateBinding IconSource}"
                                         ActionIconSource="{TemplateBinding ActionIconSource}"
                                         Footer="{TemplateBinding Footer}"
                                         FooterTemplate="{TemplateBinding FooterTemplate}"
                                         HorizontalAlignment="Stretch"
                                         HorizontalContentAlignment="Stretch"
                                         Padding="{DynamicResource SettingsExpanderPadding}"
                                         Background="Transparent"
                                         Name="ContentHost" />
            </Expander.Header>

            <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
          </Expander>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ Expander#Expander">
        <!-- The library helper translates then hides content; this host owns the layout reveal. -->
        <Setter Property="ui:FAExpanderExt.ExpanderAnimationType" Value="{x:Null}" />
      </Style>
    </ControlTheme>

  </Window.Resources>

  <Window.Styles>
    <Style Selector=".compact-settings-combo"
           x:SetterTargetType="ui:FAComboBox">
      <Setter Property="Width" Value="192" />
      <Setter Property="MaxDropDownHeight" Value="288" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector=".compact-settings-picker"
           x:SetterTargetType="Button">
      <Setter Property="Width" Value="220" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style Selector="ui|FASettingsExpanderItem.last-visible-setting /template/ Border#Root">
      <Setter Property="CornerRadius"
              Value="{Binding Source={StaticResource ControlCornerRadius}, Converter={StaticResource BottomCornerRadiusFilterConverter}}" />
    </Style>

    <Style Selector="ScrollViewer.page-scroll">
      <Setter Property="IsScrollChainingEnabled" Value="True" />
      <Setter Property="IsScrollInertiaEnabled" Value="True" />
    </Style>

    <Style Selector="Grid.linux-window-background">
      <Setter Property="Background" Value="{DynamicResource ApplicationPageBackgroundThemeBrush}" />
    </Style>
  </Window.Styles>

  <Grid x:Name="RootSurface">
    <ui:FANavigationView
                         x:Name="NavigationView"
                         PaneDisplayMode="LeftCompact"
                         IsPaneOpen="False"
                         PaneTitle="THRM"
                         IsSettingsVisible="False"
                         SelectionChanged="NavigationViewSelectionChanged">
      <ui:FANavigationView.MenuItems>
        <ui:FANavigationViewItem x:Name="StatusNavigationItem"
                                 Content="Status"
                                 Tag="status">
          <ui:FANavigationViewItem.IconSource>
            <icons:FluentIconSource Icon="Home" />
          </ui:FANavigationViewItem.IconSource>
        </ui:FANavigationViewItem>
        <ui:FANavigationViewItem Content="Fan curve" Tag="fan-curve">
          <ui:FANavigationViewItem.IconSource>
            <icons:FluentIconSource Icon="ChartMultiple" />
          </ui:FANavigationViewItem.IconSource>
        </ui:FANavigationViewItem>
        <ui:FANavigationViewItem Content="Temperature history" Tag="temperature-history">
          <ui:FANavigationViewItem.IconSource>
            <icons:FluentIconSource Icon="History" />
          </ui:FANavigationViewItem.IconSource>
        </ui:FANavigationViewItem>
        <ui:FANavigationViewItem Content="Fan control" Tag="fan-control">
          <ui:FANavigationViewItem.IconSource>
            <icons:FluentIconSource Icon="Temperature" />
          </ui:FANavigationViewItem.IconSource>
        </ui:FANavigationViewItem>
        <ui:FANavigationViewItem Content="Device settings" Tag="device-settings">
          <ui:FANavigationViewItem.IconSource>
            <icons:FluentIconSource Icon="PlugConnected" />
          </ui:FANavigationViewItem.IconSource>
        </ui:FANavigationViewItem>
        <ui:FANavigationViewItem Content="System settings" Tag="system">
          <ui:FANavigationViewItem.IconSource>
            <icons:FluentIconSource Icon="Settings" />
          </ui:FANavigationViewItem.IconSource>
        </ui:FANavigationViewItem>
        <ui:FANavigationViewItem Content="Diagnostics" Tag="diagnostics">
          <ui:FANavigationViewItem.IconSource>
            <icons:FluentIconSource Icon="Bug" />
          </ui:FANavigationViewItem.IconSource>
        </ui:FANavigationViewItem>
        <ui:FANavigationViewItem x:Name="RtssNavigationItem" Content="RTSS overlay" Tag="rtss-overlay">
          <ui:FANavigationViewItem.IconSource>
            <icons:FluentIconSource Icon="Gauge" />
          </ui:FANavigationViewItem.IconSource>
        </ui:FANavigationViewItem>
      </ui:FANavigationView.MenuItems>
      <ui:FANavigationView.FooterMenuItems>
        <ui:FANavigationViewItem Content="About" Tag="about">
          <ui:FANavigationViewItem.IconSource>
            <icons:FluentIconSource Icon="Info" />
          </ui:FANavigationViewItem.IconSource>
        </ui:FANavigationViewItem>
      </ui:FANavigationView.FooterMenuItems>
      <ui:FANavigationView.Content>
        <Grid RowDefinitions="Auto,*">
          <ui:FAInfoBar x:Name="ConnectionInfoBar"
                        Margin="24,16,24,0"
                        IsOpen="False"
                        IsClosable="False"
                        Severity="Warning"
                        Title="THRM Core connection lost"
                        Message="Retrying connection without replaying writes." />
          <ui:FAFrame x:Name="PageFrame"
                      Grid.Row="1"
                      ClipToBounds="True"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch" />
          <Grid x:Name="PageDefinitions" Grid.Row="1" IsVisible="False">
          <ScrollViewer x:Name="StatusPage"
                        Classes="page-scroll"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24" Spacing="24">
              <StackPanel Spacing="4">
                <TextBlock Text="Status" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Live connection, device and temperature overview."
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>

              <Border Padding="20"
                      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="8">
                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="20">
                  <StackPanel Grid.Column="0" Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <ui:FAIconSourceElement Width="20" Height="20" VerticalAlignment="Center">
                          <ui:FAIconSourceElement.IconSource>
                            <icons:FluentIconSource Icon="PlugConnected" />
                          </ui:FAIconSourceElement.IconSource>
                        </ui:FAIconSourceElement>
                        <TextBlock Text="Device" FontSize="20" FontWeight="SemiBold" />
                      </StackPanel>
                      <StackPanel Grid.Column="1"
                                  Orientation="Horizontal"
                                  Spacing="6"
                                  VerticalAlignment="Center">
                        <ui:FAIconSourceElement x:Name="DeviceStatusIcon"
                                                Width="16"
                                                Height="16"
                                                VerticalAlignment="Center">
                          <ui:FAIconSourceElement.IconSource>
                            <icons:FluentIconSource Icon="PlugDisconnected" />
                          </ui:FAIconSourceElement.IconSource>
                        </ui:FAIconSourceElement>
                        <TextBlock x:Name="DeviceText"
                                   Text="Not connected"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Right" />
                      </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnSpacing="16"
                          RowSpacing="8">
                      <TextBlock Text="Model" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      <TextBlock x:Name="ModelText"
                                 Grid.Column="1"
                                 Text="—"
                                 HorizontalAlignment="Right" />
                      <TextBlock Grid.Row="1"
                                 Text="Product ID"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      <TextBlock x:Name="ProductText"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Text="—"
                                 HorizontalAlignment="Right" />
                      <TextBlock Grid.Row="2"
                                 Text="Mode"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      <TextBlock x:Name="ModeText"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 Text="—"
                                 HorizontalAlignment="Right" />
                      <TextBlock Grid.Row="3"
                                 Text="Fan"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      <TextBlock x:Name="FanText"
                                 Grid.Row="3"
                                 Grid.Column="1"
                                 Text="—"
                                 HorizontalAlignment="Right" />
                    </Grid>
                  </StackPanel>

                  <Rectangle Grid.Column="1"
                             Width="1"
                             Margin="0,4"
                             Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />

                  <StackPanel Grid.Column="2" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <ui:FAIconSourceElement Width="20" Height="20" VerticalAlignment="Center">
                        <ui:FAIconSourceElement.IconSource>
                          <icons:FluentIconSource Icon="Temperature" />
                        </ui:FAIconSourceElement.IconSource>
                      </ui:FAIconSourceElement>
                      <TextBlock Text="Temperature" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="16"
                          RowSpacing="8">
                      <TextBlock Text="CPU" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      <TextBlock x:Name="CpuTempText"
                                 Grid.Column="1"
                                 Text="—"
                                 FontSize="20"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Right" />
                      <TextBlock Grid.Row="1"
                                 Text="GPU"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      <TextBlock x:Name="GpuTempText"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Text="—"
                                 FontSize="20"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Right" />
                      <TextBlock Grid.Row="2"
                                 Text="Max"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      <TextBlock x:Name="MaxTempText"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 Text="—"
                                 FontSize="20"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock x:Name="BridgeText"
                               Text="Temperature bridge —"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="LastUpdateText"
                               Text="No state received"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </Border>

           </StackPanel>
          </ScrollViewer>

          <ScrollViewer x:Name="FanCurvePage"
                        Classes="page-scroll"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24" Spacing="16">
              <StackPanel Spacing="4">
                <TextBlock Text="Fan curve" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Set the target fan speed for each temperature point through THRM Core."
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>

              <ui:FASettingsExpander Theme="{StaticResource THRMSettingsExpanderTheme}"
                                     Header="Curve editor"
                                     Description="Temperatures must increase from top to bottom; target speeds cannot decrease."
                                     IsExpanded="True">
                <ui:FASettingsExpander.IconSource>
                  <icons:FluentIconSource Icon="DataLine" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpanderItem Content="Interactive curve"
                                           Description="Drag a point vertically to set its target speed. Changes are applied to THRM Core only when you select Apply changes.">
                  <local:FanCurvePreview x:Name="FanCurvePreview"
                                          Height="320"
                                          HorizontalAlignment="Stretch" />
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpander.Footer>
                  <Grid ColumnDefinitions="*,Auto,Auto"
                        ColumnSpacing="8">
                      <ui:FAComboBox x:Name="FanCurveProfileComboBox"
                                     HorizontalAlignment="Stretch"
                                     IsEnabled="False"
                                     SelectionChanged="FanCurveProfileSelectionChanged">
                      </ui:FAComboBox>
                      <Button x:Name="FanCurveProfileManageButton"
                              Grid.Column="1"
                              Content="Manage"
                              IsEnabled="False">
                        <Button.Flyout>
                          <ui:FAMenuFlyout Opening="MenuFlyoutOpening"
                                           Opened="MenuFlyoutOpened">
                            <ui:FAMenuFlyoutItem x:Name="FanCurveNewProfileMenuItem"
                                                  Text="New profile"
                                                  Click="NewFanCurveProfileClick"
                                                  IsEnabled="False">
                              <ui:FAMenuFlyoutItem.IconSource>
                                <icons:FluentIconSource Icon="Add" />
                              </ui:FAMenuFlyoutItem.IconSource>
                            </ui:FAMenuFlyoutItem>
                            <ui:FAMenuFlyoutItem x:Name="FanCurveRenameProfileMenuItem"
                                                  Text="Rename current"
                                                  Click="RenameFanCurveProfileClick"
                                                  IsEnabled="False">
                              <ui:FAMenuFlyoutItem.IconSource>
                                <icons:FluentIconSource Icon="Rename" />
                              </ui:FAMenuFlyoutItem.IconSource>
                            </ui:FAMenuFlyoutItem>
                            <ui:FAMenuFlyoutItem x:Name="FanCurveDeleteProfileMenuItem"
                                                  Text="Delete current"
                                                  Click="DeleteFanCurveProfileClick"
                                                  IsEnabled="False">
                              <ui:FAMenuFlyoutItem.IconSource>
                                <icons:FluentIconSource Icon="Delete" />
                              </ui:FAMenuFlyoutItem.IconSource>
                            </ui:FAMenuFlyoutItem>
                            <ui:FAMenuFlyoutSeparator />
                            <ui:FAMenuFlyoutItem x:Name="FanCurveExportProfilesMenuItem"
                                                  Text="Export and copy code"
                                                  Click="ExportFanCurveProfilesClick"
                                                  IsEnabled="False">
                              <ui:FAMenuFlyoutItem.IconSource>
                                <icons:FluentIconSource Icon="ArrowExport" />
                              </ui:FAMenuFlyoutItem.IconSource>
                            </ui:FAMenuFlyoutItem>
                            <ui:FAMenuFlyoutItem x:Name="FanCurveImportProfilesMenuItem"
                                                  Text="Import code from clipboard"
                                                  Click="ImportFanCurveProfilesFromClipboardClick"
                                                  IsEnabled="False">
                              <ui:FAMenuFlyoutItem.IconSource>
                                <icons:FluentIconSource Icon="ClipboardPaste" />
                              </ui:FAMenuFlyoutItem.IconSource>
                            </ui:FAMenuFlyoutItem>
                          </ui:FAMenuFlyout>
                        </Button.Flyout>
                      </Button>
                      <Button x:Name="ApplyFanCurveButton"
                              Grid.Column="2"
                              Classes="accent"
                              Content="Apply changes"
                              Click="ApplyFanCurveClick"
                              IsEnabled="False" />
                    </Grid>
                </ui:FASettingsExpander.Footer>
              </ui:FASettingsExpander>

              <ui:FASettingsExpander x:Name="TimeCurveScheduleExpander"
                                     Theme="{StaticResource THRMSettingsExpanderTheme}"
                                     Header="Time curve schedule"
                                     Description="Let THRM Core switch curve profiles automatically by time and weekday."
                                     IsExpanded="False">
                <ui:FASettingsExpander.IconSource>
                  <icons:FluentIconSource Icon="History" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpander.Footer>
                  <ToggleSwitch x:Name="TimeCurveScheduleEnabledSwitch"
                                AutomationProperties.Name="Enable time curve schedule"
                                VerticalAlignment="Center"
                                IsEnabled="False"
                                Click="TimeCurveScheduleEnabledClick" />
                </ui:FASettingsExpander.Footer>
                <ui:FASettingsExpanderItem x:Name="TimeCurveScheduleRulesHost">
                  <StackPanel x:Name="TimeCurveScheduleRulesPanel"
                              Spacing="8">
                    <TextBlock x:Name="TimeCurveScheduleSupportText"
                               IsVisible="False"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="Please update or restart THRM Core to use time curve schedules." />
                  </StackPanel>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="Add rule"
                                           Description="Create a profile switch for a time window and selected weekdays.">
                  <ui:FASettingsExpanderItem.Footer>
                    <Button x:Name="AddTimeCurveScheduleRuleButton"
                            Content="Add rule"
                            HorizontalAlignment="Right"
                            Click="AddTimeCurveScheduleRuleClick"
                            IsEnabled="False" />
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
              </ui:FASettingsExpander>

              <ui:FASettingsExpander Theme="{StaticResource THRMSettingsExpanderTheme}"
                                     Header="Speed avoidance"
                                     Description="Avoid a fan-speed range that causes audible resonance."
                                     IsExpanded="False">
                <ui:FASettingsExpander.IconSource>
                  <icons:FluentIconSource Icon="Gauge" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpander.Footer>
                  <ToggleSwitch x:Name="SpeedAvoidanceEnabledSwitch"
                                AutomationProperties.Name="Enable speed avoidance"
                                VerticalAlignment="Center"
                                IsEnabled="False"
                                Click="SpeedAvoidanceEnabledClick" />
                </ui:FASettingsExpander.Footer>
                <ui:FASettingsExpanderItem Content="Minimum speed"
                                           Description="Set the lower edge of the avoided speed range.">
                  <ui:FASettingsExpanderItem.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <ui:FANumberBox x:Name="SpeedAvoidanceMinRpmNumberBox"
                                       Width="112"
                                       Minimum="800"
                                       Maximum="4500"
                                       SmallChange="50"
                                       SpinButtonPlacementMode="Compact"
                                       IsEnabled="False"
                                       Value="1900"
                                       ValueChanged="SpeedAvoidanceValueChanged" />
                      <TextBlock Text="RPM" VerticalAlignment="Center" />
                    </StackPanel>
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="Maximum speed"
                                           Description="Set the upper edge of the avoided speed range.">
                  <ui:FASettingsExpanderItem.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <ui:FANumberBox x:Name="SpeedAvoidanceMaxRpmNumberBox"
                                       Width="112"
                                       Minimum="800"
                                       Maximum="4500"
                                       SmallChange="50"
                                       SpinButtonPlacementMode="Compact"
                                       IsEnabled="False"
                                       Value="2200"
                                       ValueChanged="SpeedAvoidanceValueChanged" />
                      <TextBlock Text="RPM" VerticalAlignment="Center" />
                    </StackPanel>
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="Safety margin"
                                           Description="Keep this distance from the resonant range when changing speed.">
                  <ui:FASettingsExpanderItem.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <ui:FANumberBox x:Name="SpeedAvoidanceMarginRpmNumberBox"
                                       Width="112"
                                       Minimum="50"
                                       Maximum="500"
                                       SmallChange="50"
                                       SpinButtonPlacementMode="Compact"
                                       IsEnabled="False"
                                       Value="100"
                                       ValueChanged="SpeedAvoidanceValueChanged" />
                      <TextBlock Text="RPM" VerticalAlignment="Center" />
                    </StackPanel>
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="Emergency bypass temperature"
                                           Description="Allow the fan to use the avoided range above this temperature.">
                  <ui:FASettingsExpanderItem.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <ui:FANumberBox x:Name="SpeedAvoidanceBypassTempNumberBox"
                                       Width="112"
                                       Minimum="60"
                                       Maximum="95"
                                       SmallChange="1"
                                       SpinButtonPlacementMode="Compact"
                                       IsEnabled="False"
                                       Value="80"
                                       ValueChanged="SpeedAvoidanceValueChanged" />
                      <TextBlock Text="°C" VerticalAlignment="Center" />
                    </StackPanel>
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
              </ui:FASettingsExpander>

              <ui:FASettingsExpander Theme="{StaticResource THRMSettingsExpanderTheme}"
                                     Header="Curve learning"
                                     Description="Manage the adaptive speed offsets learned by THRM Core."
                                     IsExpanded="False">
                <ui:FASettingsExpander.IconSource>
                  <icons:FluentIconSource Icon="BrainCircuit" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpander.Footer>
                  <ToggleSwitch x:Name="FanCurveLearningEnabledSwitch"
                                AutomationProperties.Name="Enable curve learning"
                                VerticalAlignment="Center"
                                IsEnabled="False"
                                Click="FanCurveLearningEnabledClick" />
                </ui:FASettingsExpander.Footer>
                <ui:FASettingsExpanderItem Content="Learning bias"
                                           Description="Choose whether learned corrections favor balanced control, cooling, or quieter operation.">
                  <ui:FASettingsExpanderItem.Footer>
                    <ui:FAComboBox x:Name="FanCurveLearningBiasComboBox"
                                   Classes="compact-settings-combo"
                                   IsEnabled="False"
                                   SelectionChanged="FanCurveLearningBiasSelectionChanged">
                      <ui:FAComboBoxItem Content="Balanced" />
                      <ui:FAComboBoxItem Content="Favor cooling" />
                      <ui:FAComboBoxItem Content="Favor quiet" />
                    </ui:FAComboBox>
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="Predictive boost"
                                           Description="Let THRM raise fan speed early when the temperature trend is rising.">
                  <ui:FASettingsExpanderItem.Footer>
                    <ToggleSwitch x:Name="FanCurvePredictiveBoostSwitch"
                                  IsEnabled="False"
                                  Click="FanCurvePredictiveBoostClick" />
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem x:Name="FanCurveLaptopFanGuardSetting"
                                           Content="Laptop fan guard"
                                           Description="Slow ramp-down while a detected laptop fan is still spinning."
                                           IsVisible="False">
                  <ui:FASettingsExpanderItem.Footer>
                    <ToggleSwitch x:Name="FanCurveLaptopFanGuardSwitch"
                                  IsEnabled="False"
                                  Click="FanCurveLaptopFanGuardClick" />
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="Target temperature"
                                           Description="Set the temperature curve learning aims to hold.">
                  <ui:FASettingsExpanderItem.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <ui:FANumberBox x:Name="FanCurveTargetTempNumberBox"
                                       Width="112"
                                       Minimum="45"
                                       Maximum="90"
                                       SmallChange="1"
                                       SpinButtonPlacementMode="Compact"
                                       Value="68"
                                       IsEnabled="False" />
                      <TextBlock Text="°C" VerticalAlignment="Center" />
                      <Button x:Name="ApplyFanCurveTargetTempButton"
                              Classes="accent"
                              Content="Apply"
                              IsEnabled="False"
                              Click="ApplyFanCurveTargetTempClick" />
                    </StackPanel>
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="Largest active corrections">
                  <ui:FASettingsExpanderItem.Resources>
                    <x:Double x:Key="SettingsExpanderItemAdaptiveWidthTrigger">10000</x:Double>
                    <Thickness x:Key="SettingsExpanderItemBottomFooterMargin">42,8,0,0</Thickness>
                  </ui:FASettingsExpanderItem.Resources>
                  <ui:FASettingsExpanderItem.Footer>
                    <WrapPanel x:Name="LearnedOffsetsSummaryPanel"
                               Orientation="Horizontal"
                               ItemSpacing="12"
                               LineSpacing="6" />
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="Reset learned offsets"
                                           Description="Forget adaptive RPM corrections. The base fan curve is unchanged.">
                  <ui:FASettingsExpanderItem.Footer>
                    <Button x:Name="ResetLearnedOffsetsButton"
                            Content="Reset"
                            Click="ResetLearnedOffsetsClick"
                            IsEnabled="False" />
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
              </ui:FASettingsExpander>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer x:Name="TemperatureHistoryPage"
                        Classes="page-scroll"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24" Spacing="16">
              <StackPanel Spacing="4">
                <TextBlock Text="Temperature history" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Review CPU/GPU temperatures and device fan speed recorded by THRM Core over time."
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>

              <ui:FASettingsExpander Theme="{StaticResource THRMSettingsExpanderTheme}"
                                     Header="Recording"
                                     Description="THRM Core keeps this history while the application window is closed."
                                     IsExpanded="False">
                <ui:FASettingsExpander.IconSource>
                  <icons:FluentIconSource Icon="History" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpander.Footer>
                  <ToggleSwitch x:Name="TemperatureHistoryEnabledSwitch"
                                AutomationProperties.Name="Enable background recording"
                                VerticalAlignment="Center"
                                IsEnabled="False"
                                Click="TemperatureHistoryEnabledClick" />
                </ui:FASettingsExpander.Footer>
                <ui:FASettingsExpanderItem Content="Retention"
                                           Description="Choose how long THRM Core retains recorded samples.">
                  <ui:FASettingsExpanderItem.Footer>
                    <ui:FAComboBox x:Name="TemperatureHistoryRetentionComboBox"
                                   Classes="compact-settings-combo"
                                   IsEnabled="False"
                                   SelectionChanged="TemperatureHistoryRetentionSelectionChanged">
                      <ui:FAComboBoxItem Content="1 hour" />
                      <ui:FAComboBoxItem Content="2 hours" />
                      <ui:FAComboBoxItem Content="3 hours" />
                      <ui:FAComboBoxItem Content="6 hours" />
                      <ui:FAComboBoxItem Content="12 hours" />
                      <ui:FAComboBoxItem Content="24 hours" />
                    </ui:FAComboBox>
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Description="Current availability.">
                  <TextBlock x:Name="TemperatureHistoryStateText"
                             Text="Waiting for THRM Core."
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             TextWrapping="Wrap" />
                </ui:FASettingsExpanderItem>
              </ui:FASettingsExpander>

              <ui:FASettingsExpander Theme="{StaticResource THRMSettingsExpanderTheme}"
                                     Header="Hardware history"
                                     Description="Review recorded CPU/GPU temperatures, device fan RPM, and power readings."
                                     IsExpanded="True">
                <ui:FASettingsExpander.IconSource>
                  <icons:FluentIconSource Icon="DataLine" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpanderItem Content="Recent trend"
                                           Description="Samples are shown in chronological order from the selected retention window.">
                  <StackPanel Spacing="8"
                              HorizontalAlignment="Stretch">
                    <local:TemperatureHistoryPreview x:Name="TemperatureHistoryPreview"
                                                     Height="260"
                                                     HorizontalAlignment="Stretch" />
                    <TextBlock Margin="0,8,0,0"
                               Text="Drag across either chart to zoom; double-click to reset."
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Stretch" />
                  </StackPanel>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="Power history"
                                           Description="Hover either chart to inspect the same recorded time.">
                  <local:TemperatureHistoryPreview x:Name="PowerHistoryPreview"
                                                   Metric="Power"
                                                   Height="220"
                                                   HorizontalAlignment="Stretch" />
                </ui:FASettingsExpanderItem>
              </ui:FASettingsExpander>

              <ui:FASettingsExpander Theme="{StaticResource THRMSettingsExpanderTheme}"
                                     Header="Window summary"
                                     Description="Peak, average, and latest values from the selected retention window."
                                     IsExpanded="False">
                <ui:FASettingsExpander.IconSource>
                  <icons:FluentIconSource Icon="ChartMultiple" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpanderItem>
                  <Grid Margin="0,4"
                        ColumnDefinitions="*,*"
                        RowDefinitions="Auto,Auto"
                        ColumnSpacing="24"
                        RowSpacing="12">
                    <StackPanel Spacing="2">
                      <TextBlock Text="CPU temperature" FontWeight="SemiBold" />
                      <TextBlock x:Name="TemperatureHistoryCpuSummaryText"
                                 Text="No recorded CPU temperatures."
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="GPU temperature" FontWeight="SemiBold" />
                      <TextBlock x:Name="TemperatureHistoryGpuSummaryText"
                                 Text="No recorded GPU temperatures."
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="2">
                      <TextBlock Text="Device fan" FontWeight="SemiBold" />
                      <TextBlock x:Name="TemperatureHistoryFanSummaryText"
                                 Text="No recorded fan speeds."
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                      <TextBlock Text="Last sample" FontWeight="SemiBold" />
                      <TextBlock x:Name="TemperatureHistoryLastSampleText"
                                 Text="No recorded samples."
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </ui:FASettingsExpanderItem>
              </ui:FASettingsExpander>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer x:Name="FanControlPage"
                        Classes="page-scroll"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24" Spacing="16">
              <StackPanel Spacing="4">
                <TextBlock Text="Fan control" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Manage automatic and manual fan behavior through the connected THRM Core."
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>

              <ui:FASettingsExpander Theme="{StaticResource THRMSettingsExpanderTheme}"
                                     Header="Fan behavior"
                                     Description="Choose how THRM Core manages the device."
                                     IsExpanded="True">
                <ui:FASettingsExpander.IconSource>
                  <icons:FluentIconSource Icon="Temperature" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpanderItem Content="Automatic control"
                                           Description="Let THRM Core manage the fan preset.">
                  <ui:FASettingsExpanderItem.Footer>
                    <ToggleSwitch x:Name="AutoControlSwitch"
                                  IsEnabled="False"
                                  Click="AutoControlClick" />
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
              </ui:FASettingsExpander>

              <ui:FASettingsExpander Theme="{StaticResource THRMSettingsExpanderTheme}"
                                     Header="Temperature control"
                                     Description="Choose which temperature readings drive automatic fan control."
                                     IsExpanded="False">
                <ui:FASettingsExpander.IconSource>
                  <icons:FluentIconSource Icon="Temperature" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpanderItem Content="Control temperature source"
                                           Description="Select the temperature source THRM uses for automatic fan control.">
                  <ui:FASettingsExpanderItem.Footer>
                    <ui:FAComboBox x:Name="TempSourceComboBox"
                                   Classes="compact-settings-combo"
                                   IsEnabled="False"
                                   SelectionChanged="TempSourceSelectionChanged">
                      <ui:FAComboBoxItem Content="Highest temperature" />
                      <ui:FAComboBoxItem Content="CPU only" />
                      <ui:FAComboBoxItem Content="GPU only" />
                    </ui:FAComboBox>
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="Temperature smoothing"
                                           Description="Average recent readings while automatic control is enabled.">
                  <ui:FASettingsExpanderItem.Footer>
                    <ui:FAComboBox x:Name="TempSampleCountComboBox"
                                   Classes="compact-settings-combo"
                                   IsEnabled="False"
                                   SelectionChanged="TempSampleCountSelectionChanged">
                      <ui:FAComboBoxItem Content="1 · Instant response" />
                      <ui:FAComboBoxItem Content="2 · Light smoothing" />
                      <ui:FAComboBoxItem Content="3 · Default" />
                      <ui:FAComboBoxItem Content="5 · Stronger smoothing" />
                      <ui:FAComboBoxItem Content="10 · Heavy smoothing" />
                    </ui:FAComboBox>
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
              </ui:FASettingsExpander>

              <ui:FASettingsExpander Theme="{StaticResource THRMSettingsExpanderTheme}"
                                      Header="Custom fan speed"
                                      Description="Hold the connected device at a specific target speed."
                                      IsExpanded="False">
                <ui:FASettingsExpander.IconSource>
                  <icons:FluentIconSource Icon="Gauge" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpander.Footer>
                  <ToggleSwitch x:Name="CustomSpeedSwitch"
                                AutomationProperties.Name="Enable custom speed"
                                VerticalAlignment="Center"
                                IsEnabled="False"
                                Click="CustomSpeedClick" />
                </ui:FASettingsExpander.Footer>
                <ui:FASettingsExpanderItem Content="Target speed"
                                           Description="Choose a value from 1,000 to 4,000 RPM.">
                  <ui:FASettingsExpanderItem.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ui:FANumberBox x:Name="CustomSpeedNumberBox"
                                     Width="112"
                                     Value="2000"
                                     Minimum="1000"
                                     Maximum="4000"
                                     SmallChange="50"
                                     SpinButtonPlacementMode="Compact"
                                     IsEnabled="False" />
                    <TextBlock Text="RPM" VerticalAlignment="Center" />
                    <Button x:Name="ApplyCustomSpeedButton"
                            Classes="accent"
                            Content="Apply"
                            Click="ApplyCustomSpeedClick"
                            IsEnabled="False" />
                    </StackPanel>
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
              </ui:FASettingsExpander>

              <ui:FASettingsExpander x:Name="ManualFanControlExpander"
                                      Theme="{StaticResource THRMSettingsExpanderTheme}"
                                      Header="Manual gear"
                                      Description="Choose a manual gear and target speed."
                                      IsExpanded="False">
                <ui:FASettingsExpander.IconSource>
                  <icons:FluentIconSource Icon="Temperature" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpanderItem Content="Gear preset"
                                           Description="Select a preset.">
                  <ui:FASettingsExpanderItem.Footer>
                    <ui:FAComboBox x:Name="ManualGearComboBox"
                                   Classes="compact-settings-combo"
                                   SelectedIndex="-1"
                                   IsEnabled="False"
                                   SelectionChanged="ManualSelectionChanged">
                      <ui:FAComboBoxItem Content="Quiet" />
                      <ui:FAComboBoxItem Content="Standard" />
                      <ui:FAComboBoxItem Content="Strong" />
                      <ui:FAComboBoxItem Content="Overclock" />
                    </ui:FAComboBox>
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem x:Name="ManualLevelSetting"
                                           Content="Level"
                                           Description="Select a level when supported.">
                  <ui:FASettingsExpanderItem.Footer>
                    <ui:FAComboBox x:Name="ManualLevelComboBox"
                                   Classes="compact-settings-combo"
                                   SelectedIndex="-1"
                                   IsEnabled="False"
                                   SelectionChanged="ManualSelectionChanged">
                      <ui:FAComboBoxItem Content="Low" />
                      <ui:FAComboBoxItem Content="Medium" />
                      <ui:FAComboBoxItem Content="High" />
                    </ui:FAComboBox>
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem x:Name="ManualGearRpmSetting"
                                           Content="Target speed"
                                           Description="Adjust the selected preset before applying it.">
                  <ui:FASettingsExpanderItem.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <ui:FANumberBox x:Name="ManualGearRpmNumberBox"
                                       Width="112"
                                       Minimum="800"
                                       Maximum="4500"
                                       SmallChange="50"
                                       SpinButtonPlacementMode="Compact"
                                       IsEnabled="False"
                                       Value="2400" />
                      <TextBlock Text="RPM" VerticalAlignment="Center" />
                    </StackPanel>
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="Apply preset"
                                           Description="Set the selected manual gear on the connected device.">
                  <Button x:Name="ApplyManualGearButton"
                          Content="Apply"
                          HorizontalAlignment="Right"
                          Click="ApplyManualGearClick"
                          IsEnabled="False" />
                </ui:FASettingsExpanderItem>
              </ui:FASettingsExpander>

            </StackPanel>
          </ScrollViewer>

          <ScrollViewer x:Name="DeviceSettingsPage"
                        Classes="page-scroll"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24" Spacing="16">
              <StackPanel Spacing="4">
                <TextBlock Text="Device settings" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Manage the connected device through the existing THRM Core actions."
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>

              <ui:FASettingsExpander Theme="{StaticResource THRMSettingsExpanderTheme}"
                                     Header="Device connection"
                                     Description="Connect or disconnect the currently detected device through THRM Core."
                                     IsExpanded="True">
                <ui:FASettingsExpander.IconSource>
                  <icons:FluentIconSource Icon="PlugConnected" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpanderItem Description="Use the available actions.">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ConnectDeviceButton"
                            Content="Connect device"
                            Click="ConnectDeviceClick"
                            IsEnabled="False" />
                    <Button x:Name="DisconnectDeviceButton"
                            Content="Disconnect device"
                            Click="DisconnectDeviceClick"
                            IsEnabled="False" />
                  </StackPanel>
                </ui:FASettingsExpanderItem>
              </ui:FASettingsExpander>

              <ui:FASettingsExpander x:Name="LightingDeviceExpander"
                                     Theme="{StaticResource THRMSettingsExpanderTheme}"
                                     Header="Lighting effects"
                                     Description="Stage supported light-strip effects and apply them to the connected device."
                                     IsExpanded="False">
                <ui:FASettingsExpander.IconSource>
                  <icons:FluentIconSource Icon="Lightbulb" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpanderItem Content="Effect mode"
                                           Description="Choose how the device lighting behaves.">
                  <ui:FASettingsExpanderItem.Footer>
                    <ui:FAComboBox x:Name="LightModeComboBox"
                                   Classes="compact-settings-combo"
                                   IsEnabled="False"
                                   SelectionChanged="LightModeSelectionChanged">
                      <ui:FAComboBoxItem Content="Off" />
                      <ui:FAComboBoxItem Content="Smart temperature" />
                      <ui:FAComboBoxItem Content="Static color" />
                      <ui:FAComboBoxItem Content="Multicolor" />
                      <ui:FAComboBoxItem Content="Rotation" />
                      <ui:FAComboBoxItem Content="Flowing" />
                      <ui:FAComboBoxItem Content="Breathing" />
                    </ui:FAComboBox>
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="Animation speed"
                                           Description="Available for animated effects.">
                  <ui:FASettingsExpanderItem.Footer>
                    <ui:FAComboBox x:Name="LightSpeedComboBox"
                                   Classes="compact-settings-combo"
                                   IsEnabled="False"
                                   SelectionChanged="LightSpeedSelectionChanged">
                      <ui:FAComboBoxItem Content="Fast" />
                      <ui:FAComboBoxItem Content="Medium" />
                      <ui:FAComboBoxItem Content="Slow" />
                    </ui:FAComboBox>
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="Brightness"
                                           Description="Set the light-strip brightness.">
                  <ui:FASettingsExpanderItem.Resources>
                    <x:Double x:Key="SettingsExpanderItemAdaptiveWidthTrigger">720</x:Double>
                  </ui:FASettingsExpanderItem.Resources>
                  <ui:FASettingsExpanderItem.Footer>
                    <Grid Width="300" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                      <TextBlock x:Name="LightBrightnessValueText"
                                 Text="100"
                                 VerticalAlignment="Center" />
                      <Slider x:Name="LightBrightnessSlider"
                              Grid.Column="1"
                              Minimum="0"
                              Maximum="100"
                              TickFrequency="1"
                              IsSnapToTickEnabled="True"
                              IsEnabled="False"
                              ValueChanged="LightBrightnessValueChanged" />
                    </Grid>
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem x:Name="LightSmartTemperatureDeviceSetting"
                                           Description="Smart temperature owns the colors and brightness automatically.">
                  <ui:FAInfoBar x:Name="LightSmartTemperatureInfoBar"
                                IsOpen="False"
                                IsClosable="False"
                                Severity="Informational"
                                Title="Smart temperature"
                                Message="Core owns the colors and brightness while this mode is active." />
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem x:Name="LightColorPresetSetting"
                                           Content="Theme preset"
                                           Description="Select a predefined color palette.">
                  <ui:FASettingsExpanderItem.Footer>
                    <WrapPanel x:Name="LightColorPresetPanel"
                               ItemSpacing="8"
                               LineSpacing="8"
                               IsEnabled="False">
                      <Button Content="Neon"
                              Tag="neon"
                              Click="LightPresetClick"
                              AutomationProperties.Name="Apply Neon lighting preset" />
                      <Button Content="Forest"
                              Tag="forest"
                              Click="LightPresetClick"
                              AutomationProperties.Name="Apply Forest lighting preset" />
                      <Button Content="Glacier"
                              Tag="glacier"
                              Click="LightPresetClick"
                              AutomationProperties.Name="Apply Glacier lighting preset" />
                    </WrapPanel>
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem x:Name="LightColorsDeviceSetting"
                                           Content="Custom colors"
                                           Description="Edit individual color slots.">
                  <ui:FASettingsExpanderItem.Resources>
                    <x:Double x:Key="SettingsExpanderItemAdaptiveWidthTrigger">800</x:Double>
                  </ui:FASettingsExpanderItem.Resources>
                  <ui:FASettingsExpanderItem.Footer>
                    <WrapPanel ItemSpacing="12" LineSpacing="10">
                      <StackPanel x:Name="LightColorSlot0"
                                  Orientation="Horizontal"
                                  Spacing="8"
                                  VerticalAlignment="Center">
                        <TextBlock Text="Color 1" VerticalAlignment="Center" />
                        <ColorPicker x:Name="LightColorPicker0"
                                     Color="#FFFF0000"
                                     IsAlphaEnabled="False"
                                     IsEnabled="False"
                                     Width="88"
                                     VerticalAlignment="Center"
                                     AutomationProperties.Name="Lighting color 1"
                                     ColorChanged="LightColorChanged" />
                      </StackPanel>
                      <StackPanel x:Name="LightColorSlot1"
                                  Orientation="Horizontal"
                                  Spacing="8"
                                  VerticalAlignment="Center">
                        <TextBlock Text="Color 2" VerticalAlignment="Center" />
                        <ColorPicker x:Name="LightColorPicker1"
                                     Color="#FF00FF00"
                                     IsAlphaEnabled="False"
                                     IsEnabled="False"
                                     Width="88"
                                     VerticalAlignment="Center"
                                     AutomationProperties.Name="Lighting color 2"
                                     ColorChanged="LightColorChanged" />
                      </StackPanel>
                      <StackPanel x:Name="LightColorSlot2"
                                  Orientation="Horizontal"
                                  Spacing="8"
                                  VerticalAlignment="Center">
                        <TextBlock Text="Color 3" VerticalAlignment="Center" />
                        <ColorPicker x:Name="LightColorPicker2"
                                     Color="#FF0080FF"
                                     IsAlphaEnabled="False"
                                     IsEnabled="False"
                                     Width="88"
                                     VerticalAlignment="Center"
                                     AutomationProperties.Name="Lighting color 3"
                                     ColorChanged="LightColorChanged" />
                      </StackPanel>
                    </WrapPanel>
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="Apply lighting"
                                           Description="Changes remain local until you explicitly apply them to THRM Core.">
                  <ui:FASettingsExpanderItem.Footer>
                    <Button x:Name="ApplyLightStripButton"
                            Classes="accent"
                            Content="Apply lighting"
                            IsEnabled="False"
                            Click="ApplyLightStripClick" />
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
              </ui:FASettingsExpander>

              <ui:FASettingsExpander Theme="{StaticResource THRMSettingsExpanderTheme}"
                                     Header="Hardware behavior"
                                     Description="Configure supported device behavior while the device is connected."
                                     IsExpanded="False">
                <ui:FASettingsExpander.IconSource>
                  <icons:FluentIconSource Icon="Settings" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpanderItem x:Name="GearLightDeviceSetting"
                                           Content="Gear light"
                                           Description="Show the selected gear on supported devices.">
                  <ui:FASettingsExpanderItem.Footer>
                    <ToggleSwitch x:Name="GearLightSwitch"
                                  IsEnabled="False"
                                  Click="GearLightClick" />
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="Power-on start"
                                           Description="Restore the device behavior when it receives power.">
                  <ui:FASettingsExpanderItem.Footer>
                    <ToggleSwitch x:Name="PowerOnStartSwitch"
                                  IsEnabled="False"
                                  Click="PowerOnStartClick" />
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem x:Name="SmartStartStopDeviceSetting"
                                           Content="Smart start/stop"
                                           Description="Choose when cooling stops after the system shuts down.">
                  <ui:FASettingsExpanderItem.Footer>
                    <ui:FAComboBox x:Name="SmartStartStopComboBox"
                                   Classes="compact-settings-combo"
                                   IsEnabled="False"
                                   SelectionChanged="SmartStartStopSelectionChanged">
                      <ui:FAComboBoxItem Content="Off" />
                      <ui:FAComboBoxItem Content="Immediate" />
                      <ui:FAComboBoxItem Content="Delayed" />
                    </ui:FAComboBox>
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
              </ui:FASettingsExpander>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer x:Name="SystemPage"
                        Classes="page-scroll"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24" Spacing="16">
              <StackPanel Spacing="4">
                <TextBlock Text="System settings" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Configure system-level THRM behavior without changing device settings."
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>

              <ui:FASettingsExpander Theme="{StaticResource THRMSettingsExpanderTheme}"
                                     Header="Appearance"
                                     Description="Choose the color mode used by the Avalonia client."
                                     IsExpanded="False">
                <ui:FASettingsExpander.IconSource>
                  <icons:FluentIconSource Icon="Lightbulb" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpanderItem Content="App theme"
                                           Description="System follows your operating-system preference.">
                  <ui:FASettingsExpanderItem.Footer>
                    <ui:FAComboBox x:Name="ThemeModeComboBox"
                                   Classes="compact-settings-combo"
                                   IsEnabled="False"
                                   SelectionChanged="ThemeModeSelectionChanged">
                      <ui:FAComboBoxItem Content="System" />
                      <ui:FAComboBoxItem Content="Light" />
                      <ui:FAComboBoxItem Content="Dark" />
                    </ui:FAComboBox>
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
              </ui:FASettingsExpander>

              <ui:FASettingsExpander Theme="{StaticResource THRMSettingsExpanderTheme}"
                                     Header="Keyboard shortcuts"
                                     Description="Set global shortcuts with Ctrl/Alt/Shift/Win + A-Z, 0-9, or F1-F12."
                                     IsExpanded="False">
                <ui:FASettingsExpander.IconSource>
                  <icons:FluentIconSource Icon="Settings" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpanderItem Content="Toggle manual gear"
                                           Description="Focus the field and press a supported shortcut. Delete or Backspace clears it; Escape cancels.">
                  <ui:FASettingsExpanderItem.Footer>
                    <TextBox x:Name="ManualGearHotkeyTextBox"
                             Tag="manual"
                             Width="220"
                             IsReadOnly="True"
                             IsEnabled="False"
                             PlaceholderText="Press a shortcut"
                             HorizontalContentAlignment="Center"
                             AutomationProperties.Name="Toggle manual gear shortcut"
                             KeyDown="HotkeyTextBoxKeyDown"
                             LostFocus="HotkeyTextBoxLostFocus" />
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="Toggle automatic control"
                                           Description="Use Ctrl/Alt/Shift/Win with A-Z, 0-9, or F1-F12.">
                  <ui:FASettingsExpanderItem.Footer>
                    <TextBox x:Name="AutoControlHotkeyTextBox"
                             Tag="auto"
                             Width="220"
                             IsReadOnly="True"
                             IsEnabled="False"
                             PlaceholderText="Press a shortcut"
                             HorizontalContentAlignment="Center"
                             AutomationProperties.Name="Toggle automatic control shortcut"
                             KeyDown="HotkeyTextBoxKeyDown"
                             LostFocus="HotkeyTextBoxLostFocus" />
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="Toggle curve profile"
                                           Description="Use Ctrl/Alt/Shift/Win with A-Z, 0-9, or F1-F12.">
                  <ui:FASettingsExpanderItem.Footer>
                    <TextBox x:Name="CurveProfileHotkeyTextBox"
                             Tag="curve"
                             Width="220"
                             IsReadOnly="True"
                             IsEnabled="False"
                             PlaceholderText="Press a shortcut"
                             HorizontalContentAlignment="Center"
                             AutomationProperties.Name="Toggle curve profile shortcut"
                             KeyDown="HotkeyTextBoxKeyDown"
                             LostFocus="HotkeyTextBoxLostFocus" />
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
              </ui:FASettingsExpander>

              <ui:FASettingsExpander Theme="{StaticResource THRMSettingsExpanderTheme}"
                                     Header="Startup"
                                     Description="Start THRM automatically when you sign in."
                                     IsExpanded="False">
                <ui:FASettingsExpander.IconSource>
                  <icons:FluentIconSource Icon="Settings" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpanderItem x:Name="SystemAutoStartSetting"
                                           Content="Start THRM when I sign in"
                                           Description="The startup method is selected automatically for this platform and permission level.">
                  <ui:FASettingsExpanderItem.Footer>
                    <ToggleSwitch x:Name="SystemAutoStartSwitch"
                                  IsEnabled="False"
                                  Click="SystemAutoStartClick" />
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem>
                  <StackPanel Spacing="4">
                    <TextBlock x:Name="SystemAutoStartStateText"
                               Text="Waiting for THRM Core."
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="SystemAutoStartMethodText"
                               Text="Current method: —"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem x:Name="SystemAutoStartInfoSetting"
                                           IsVisible="False">
                  <ui:FAInfoBar x:Name="SystemAutoStartInfoBar"
                                IsOpen="False"
                                IsClosable="False"
                                Severity="Warning"
                                Title="Startup unavailable"
                                Message="Waiting for THRM Core." />
                </ui:FASettingsExpanderItem>
              </ui:FASettingsExpander>

              <ui:FASettingsExpander Theme="{StaticResource THRMSettingsExpanderTheme}"
                                     Header="Device reconnection"
                                     Description="Choose how THRM treats the device after a temporary disconnect."
                                     IsExpanded="False">
                <ui:FASettingsExpander.IconSource>
                  <icons:FluentIconSource Icon="PlugConnected" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpanderItem Content="Keep app configuration after reconnect"
                                           Description="Prevents a reconnect from falling back to the device default mode.">
                  <ui:FASettingsExpanderItem.Footer>
                    <ToggleSwitch x:Name="IgnoreDeviceOnReconnectSwitch"
                                  IsEnabled="False"
                                  Click="IgnoreDeviceOnReconnectClick" />
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
              </ui:FASettingsExpander>

              <ui:FASettingsExpander Theme="{StaticResource THRMSettingsExpanderTheme}"
                                     Header="Monitoring sources"
                                     Description="Choose the hardware temperature sources THRM uses for monitoring and fan control."
                                     IsExpanded="False">
                <ui:FASettingsExpander.IconSource>
                  <icons:FluentIconSource Icon="Temperature" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpanderItem Content="CPU temperature sensors"
                                           Description="Select one or more sensors to average. Leaving every sensor unselected uses THRM's automatic choice.">
                  <ui:FASettingsExpanderItem.Footer>
                    <Button x:Name="CpuSensorSelectionButton"
                            Classes="compact-settings-picker"
                            IsEnabled="False"
                            AutomationProperties.Name="Choose CPU temperature sensors">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock x:Name="CpuSensorSelectionText"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Text="Automatic (recommended)" />
                        <ui:FAIconSourceElement Grid.Column="1"
                                                Width="16"
                                                Height="16"
                                                VerticalAlignment="Center">
                          <ui:FAIconSourceElement.IconSource>
                            <icons:FluentIconSource Icon="ChevronDown" />
                          </ui:FAIconSourceElement.IconSource>
                        </ui:FAIconSourceElement>
                      </Grid>
                      <Button.Flyout>
                        <ui:FAMenuFlyout Opening="CpuSensorMenuFlyoutOpening"
                                         Opened="MenuFlyoutOpened"
                                         Closed="CpuSensorMenuFlyoutClosed" />
                      </Button.Flyout>
                    </Button>
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="Monitor GPU temperatures"
                                           Description="Turn this off on hybrid systems to avoid waking a discrete GPU.">
                  <ui:FASettingsExpanderItem.Footer>
                    <ToggleSwitch x:Name="GpuMonitoringSwitch"
                                  IsEnabled="False"
                                  Click="GpuMonitoringClick" />
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="GPU device"
                                           Description="Choose which detected GPU THRM monitors.">
                  <ui:FASettingsExpanderItem.Footer>
                    <ui:FAComboBox x:Name="GpuDeviceComboBox"
                                   Classes="compact-settings-combo"
                                   IsEnabled="False"
                                   SelectionChanged="GpuDeviceSelectionChanged" />
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="GPU temperature sensor"
                                           Description="Choose a sensor for the selected GPU or keep THRM's automatic choice.">
                  <ui:FASettingsExpanderItem.Footer>
                    <ui:FAComboBox x:Name="GpuSensorComboBox"
                                   Classes="compact-settings-combo"
                                   IsEnabled="False"
                                   SelectionChanged="GpuSensorSelectionChanged" />
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
              </ui:FASettingsExpander>

            </StackPanel>
          </ScrollViewer>

          <ScrollViewer x:Name="RtssOverlayPage"
                        Classes="page-scroll"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24" Spacing="16">
              <StackPanel Spacing="4">
                <TextBlock Text="RTSS overlay" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Publish THRM fan speed to RivaTuner Statistics Server while games are running."
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>

              <ui:FASettingsExpander x:Name="RtssOutputExpander"
                                     Theme="{StaticResource THRMSettingsExpanderTheme}"
                                     Header="Output"
                                     Description="Configure when THRM writes the overlay value."
                                     IsExpanded="False">
                <ui:FASettingsExpander.IconSource>
                  <icons:FluentIconSource Icon="Gauge" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpanderItem Content="Enable RTSS overlay"
                                           Description="Publish the current fan speed to the active RTSS overlay.">
                  <ui:FASettingsExpanderItem.Footer>
                    <ToggleSwitch x:Name="RtssEnabledSwitch"
                                  IsEnabled="False"
                                  Click="RtssEnabledClick" />
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="Update interval"
                                           Description="Choose how often THRM refreshes the overlay value.">
                  <ui:FASettingsExpanderItem.Footer>
                    <ui:FAComboBox x:Name="RtssIntervalComboBox"
                                   Classes="compact-settings-combo"
                                   IsEnabled="False"
                                   SelectionChanged="RtssIntervalSelectionChanged">
                      <ui:FAComboBoxItem Content="250 ms" />
                      <ui:FAComboBoxItem Content="500 ms" />
                      <ui:FAComboBoxItem Content="1 second" />
                      <ui:FAComboBoxItem Content="2 seconds" />
                    </ui:FAComboBox>
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem x:Name="RtssUnavailableSetting"
                                           Padding="0"
                                           MinHeight="0"
                                           Background="Transparent"
                                           HorizontalContentAlignment="Stretch"
                                           IsVisible="False">
                  <ui:FASettingsExpanderItem.Resources>
                    <Thickness x:Key="SettingsExpanderItemContentMargin">0</Thickness>
                  </ui:FASettingsExpanderItem.Resources>
                  <ui:FAInfoBar x:Name="RtssUnavailableInfoBar"
                                HorizontalAlignment="Stretch"
                                IsOpen="False"
                                IsClosable="False"
                                Severity="Warning"
                                Title="RTSS overlay unavailable"
                                Message="This THRM Core version does not expose RTSS configuration." />
                </ui:FASettingsExpanderItem>
              </ui:FASettingsExpander>

              <ui:FASettingsExpander x:Name="RtssPositionExpander"
                                     Theme="{StaticResource THRMSettingsExpanderTheme}"
                                     Header="Position"
                                     Description="Choose how RTSS positions the THRM value in its overlay."
                                     IsExpanded="False">
                <ui:FASettingsExpander.IconSource>
                  <icons:FluentIconSource Icon="Settings" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpanderItem Content="Position mode"
                                           Description="Use RTSS OverlayEditor positioning or provide a custom offset.">
                  <ui:FASettingsExpanderItem.Footer>
                    <ui:FAComboBox x:Name="RtssPositionModeComboBox"
                                   Classes="compact-settings-combo"
                                   IsEnabled="False"
                                   SelectionChanged="RtssPositionModeSelectionChanged">
                      <ui:FAComboBoxItem Content="RTSS OverlayEditor" />
                      <ui:FAComboBoxItem Content="Custom offset" />
                    </ui:FAComboBox>
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem x:Name="RtssAnchorPositionSetting">
                  <StackPanel Spacing="8">
                    <TextBlock Text="RTSS OverlayEditor" FontWeight="SemiBold" />
                    <TextBlock Text="THRM follows the anchor at the bottom of the active OverlayEditor layout."
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="RtssAnchorStatusText"
                               Text="Checking the active RTSS layout..."
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button x:Name="RefreshRtssAnchorButton"
                              Content="Refresh"
                              IsEnabled="False"
                              Click="RefreshRtssAnchorClick" />
                      <Button x:Name="CreateRtssAnchorButton"
                              Classes="accent"
                              Content="Set up anchor"
                              IsEnabled="False"
                              Click="CreateRtssAnchorClick" />
                    </StackPanel>
                  </StackPanel>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem x:Name="RtssCustomPositionSetting"
                                           IsVisible="False">
                  <ui:FASettingsExpanderItem.Content>
                    <StackPanel Spacing="8">
                      <TextBlock Text="Custom offset" FontWeight="SemiBold" />
                      <TextBlock Text="Preview the offset without saving it, then apply it when it is in the right position."
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                 TextWrapping="Wrap" />
                      <Grid ColumnDefinitions="Auto,112,Auto,112,Auto,Auto"
                            ColumnSpacing="8"
                            RowDefinitions="Auto,Auto"
                            RowSpacing="8">
                        <TextBlock Text="X" VerticalAlignment="Center" />
                        <ui:FANumberBox x:Name="RtssPositionXNumberBox"
                                        Grid.Column="1"
                                        Minimum="-1000"
                                        Maximum="1000"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        IsEnabled="False" />
                        <TextBlock Grid.Column="2" Text="Y" VerticalAlignment="Center" />
                        <ui:FANumberBox x:Name="RtssPositionYNumberBox"
                                        Grid.Column="3"
                                        Minimum="-1000"
                                        Maximum="1000"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        IsEnabled="False" />
                        <Button x:Name="RtssPreviewPositionButton"
                                Grid.Column="4"
                                Content="Preview"
                                IsEnabled="False"
                                Click="RtssPreviewPositionClick" />
                        <Button x:Name="RtssApplyPositionButton"
                                Grid.Column="5"
                                Classes="accent"
                                Content="Apply"
                                IsEnabled="False"
                                Click="RtssApplyPositionClick" />
                        <TextBlock x:Name="RtssPositionStatusText"
                                   Grid.Row="1"
                                   Grid.ColumnSpan="6"
                                   Text="Choose a custom offset to preview or apply it."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                      </Grid>
                    </StackPanel>
                  </ui:FASettingsExpanderItem.Content>
                </ui:FASettingsExpanderItem>
              </ui:FASettingsExpander>

              <ui:FASettingsExpander x:Name="LegionFnQExpander"
                                     Theme="{StaticResource THRMSettingsExpanderTheme}"
                                     Header="Lenovo Legion Fn+Q"
                                     Description="Map Lenovo power modes to THRM manual fan presets."
                                     IsExpanded="False"
                                     IsVisible="False">
                <ui:FASettingsExpander.IconSource>
                  <icons:FluentIconSource Icon="Settings" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpanderItem Content="Enable Fn+Q integration"
                                           Description="Listen for Lenovo power-mode changes on this computer.">
                  <ui:FASettingsExpanderItem.Footer>
                    <ToggleSwitch x:Name="LegionFnQEnabledSwitch"
                                  Click="LegionFnQEnabledClick" />
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="Take over fan preset"
                                           Description="Apply the mapped THRM manual preset whenever Fn+Q changes modes.">
                  <ui:FASettingsExpanderItem.Footer>
                    <ToggleSwitch x:Name="LegionFnQTakeOverFanSwitch"
                                  Click="LegionFnQTakeOverFanClick" />
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem x:Name="LegionFnQQuietMappingSetting"
                                           Content="Quiet"
                                           Description="Fn+Q Quiet mode.">
                  <ui:FASettingsExpanderItem.Footer>
                    <Grid ColumnDefinitions="Auto,132,Auto,104" ColumnSpacing="8">
                      <TextBlock Text="Gear" VerticalAlignment="Center" />
                      <ui:FAComboBox x:Name="LegionFnQQuietGearComboBox"
                                     Grid.Column="1"
                                     Classes="compact-settings-combo"
                                     Tag="Quiet:gear"
                                     SelectionChanged="LegionFnQMappingSelectionChanged">
                        <ui:FAComboBoxItem Content="Quiet" />
                        <ui:FAComboBoxItem Content="Standard" />
                        <ui:FAComboBoxItem Content="Strong" />
                        <ui:FAComboBoxItem Content="Overclock" />
                      </ui:FAComboBox>
                      <TextBlock Grid.Column="2" Text="Level" VerticalAlignment="Center" />
                      <ui:FAComboBox x:Name="LegionFnQQuietLevelComboBox"
                                     Grid.Column="3"
                                     Classes="compact-settings-combo"
                                     Tag="Quiet:level"
                                     SelectionChanged="LegionFnQMappingSelectionChanged">
                        <ui:FAComboBoxItem Content="Low" />
                        <ui:FAComboBoxItem Content="Medium" />
                        <ui:FAComboBoxItem Content="High" />
                      </ui:FAComboBox>
                    </Grid>
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem x:Name="LegionFnQBalanceMappingSetting"
                                           Content="Balanced"
                                           Description="Fn+Q Balance mode.">
                  <ui:FASettingsExpanderItem.Footer>
                    <Grid ColumnDefinitions="Auto,132,Auto,104" ColumnSpacing="8">
                      <TextBlock Text="Gear" VerticalAlignment="Center" />
                      <ui:FAComboBox x:Name="LegionFnQBalanceGearComboBox"
                                     Grid.Column="1"
                                     Classes="compact-settings-combo"
                                     Tag="Balance:gear"
                                     SelectionChanged="LegionFnQMappingSelectionChanged">
                        <ui:FAComboBoxItem Content="Quiet" />
                        <ui:FAComboBoxItem Content="Standard" />
                        <ui:FAComboBoxItem Content="Strong" />
                        <ui:FAComboBoxItem Content="Overclock" />
                      </ui:FAComboBox>
                      <TextBlock Grid.Column="2" Text="Level" VerticalAlignment="Center" />
                      <ui:FAComboBox x:Name="LegionFnQBalanceLevelComboBox"
                                     Grid.Column="3"
                                     Classes="compact-settings-combo"
                                     Tag="Balance:level"
                                     SelectionChanged="LegionFnQMappingSelectionChanged">
                        <ui:FAComboBoxItem Content="Low" />
                        <ui:FAComboBoxItem Content="Medium" />
                        <ui:FAComboBoxItem Content="High" />
                      </ui:FAComboBox>
                    </Grid>
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem x:Name="LegionFnQPerformanceMappingSetting"
                                           Content="Performance"
                                           Description="Fn+Q Performance mode.">
                  <ui:FASettingsExpanderItem.Footer>
                    <Grid ColumnDefinitions="Auto,132,Auto,104" ColumnSpacing="8">
                      <TextBlock Text="Gear" VerticalAlignment="Center" />
                      <ui:FAComboBox x:Name="LegionFnQPerformanceGearComboBox"
                                     Grid.Column="1"
                                     Classes="compact-settings-combo"
                                     Tag="Performance:gear"
                                     SelectionChanged="LegionFnQMappingSelectionChanged">
                        <ui:FAComboBoxItem Content="Quiet" />
                        <ui:FAComboBoxItem Content="Standard" />
                        <ui:FAComboBoxItem Content="Strong" />
                        <ui:FAComboBoxItem Content="Overclock" />
                      </ui:FAComboBox>
                      <TextBlock Grid.Column="2" Text="Level" VerticalAlignment="Center" />
                      <ui:FAComboBox x:Name="LegionFnQPerformanceLevelComboBox"
                                     Grid.Column="3"
                                     Classes="compact-settings-combo"
                                     Tag="Performance:level"
                                     SelectionChanged="LegionFnQMappingSelectionChanged">
                        <ui:FAComboBoxItem Content="Low" />
                        <ui:FAComboBoxItem Content="Medium" />
                        <ui:FAComboBoxItem Content="High" />
                      </ui:FAComboBox>
                    </Grid>
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem x:Name="LegionFnQExtremeMappingSetting"
                                           Content="Extreme"
                                           Description="Fn+Q Extreme mode.">
                  <ui:FASettingsExpanderItem.Footer>
                    <Grid ColumnDefinitions="Auto,132,Auto,104" ColumnSpacing="8">
                      <TextBlock Text="Gear" VerticalAlignment="Center" />
                      <ui:FAComboBox x:Name="LegionFnQExtremeGearComboBox"
                                     Grid.Column="1"
                                     Classes="compact-settings-combo"
                                     Tag="Extreme:gear"
                                     SelectionChanged="LegionFnQMappingSelectionChanged">
                        <ui:FAComboBoxItem Content="Quiet" />
                        <ui:FAComboBoxItem Content="Standard" />
                        <ui:FAComboBoxItem Content="Strong" />
                        <ui:FAComboBoxItem Content="Overclock" />
                      </ui:FAComboBox>
                      <TextBlock Grid.Column="2" Text="Level" VerticalAlignment="Center" />
                      <ui:FAComboBox x:Name="LegionFnQExtremeLevelComboBox"
                                     Grid.Column="3"
                                     Classes="compact-settings-combo"
                                     Tag="Extreme:level"
                                     SelectionChanged="LegionFnQMappingSelectionChanged">
                        <ui:FAComboBoxItem Content="Low" />
                        <ui:FAComboBoxItem Content="Medium" />
                        <ui:FAComboBoxItem Content="High" />
                      </ui:FAComboBox>
                    </Grid>
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem x:Name="LegionFnQGodModeMappingSetting"
                                           Content="God mode"
                                           Description="Fn+Q God Mode.">
                  <ui:FASettingsExpanderItem.Footer>
                    <Grid ColumnDefinitions="Auto,132,Auto,104" ColumnSpacing="8">
                      <TextBlock Text="Gear" VerticalAlignment="Center" />
                      <ui:FAComboBox x:Name="LegionFnQGodModeGearComboBox"
                                     Grid.Column="1"
                                     Classes="compact-settings-combo"
                                     Tag="GodMode:gear"
                                     SelectionChanged="LegionFnQMappingSelectionChanged">
                        <ui:FAComboBoxItem Content="Quiet" />
                        <ui:FAComboBoxItem Content="Standard" />
                        <ui:FAComboBoxItem Content="Strong" />
                        <ui:FAComboBoxItem Content="Overclock" />
                      </ui:FAComboBox>
                      <TextBlock Grid.Column="2" Text="Level" VerticalAlignment="Center" />
                      <ui:FAComboBox x:Name="LegionFnQGodModeLevelComboBox"
                                     Grid.Column="3"
                                     Classes="compact-settings-combo"
                                     Tag="GodMode:level"
                                     SelectionChanged="LegionFnQMappingSelectionChanged">
                        <ui:FAComboBoxItem Content="Low" />
                        <ui:FAComboBoxItem Content="Medium" />
                        <ui:FAComboBoxItem Content="High" />
                      </ui:FAComboBox>
                    </Grid>
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
              </ui:FASettingsExpander>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer x:Name="DiagnosticsPage"
                        Classes="page-scroll"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24" Spacing="16">
              <StackPanel Spacing="4">
                <TextBlock Text="Diagnostics" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Inspect THRM Core state and enable diagnostic logging when troubleshooting."
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>

              <ui:FASettingsExpander Theme="{StaticResource THRMSettingsExpanderTheme}"
                                     Header="Core diagnostics"
                                     Description="Use these controls only when you need to investigate a problem."
                                     IsExpanded="False">
                <ui:FASettingsExpander.IconSource>
                  <icons:FluentIconSource Icon="Bug" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpanderItem Content="Diagnostic logging"
                                           Description="Include debug-level events in THRM Core logs.">
                  <ui:FASettingsExpanderItem.Footer>
                    <ToggleSwitch x:Name="DebugModeSwitch"
                                  IsEnabled="False"
                                  Click="DebugModeClick" />
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="Core snapshot"
                                           Description="Read the current Core state without changing it.">
                  <ui:FASettingsExpanderItem.Footer>
                    <Button x:Name="RefreshDiagnosticsButton"
                            Content="Refresh"
                            IsEnabled="False"
                            Click="RefreshDiagnosticsClick" />
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem>
                  <TextBox x:Name="DiagnosticsSnapshotTextBox"
                           AcceptsReturn="True"
                           IsReadOnly="True"
                           MinHeight="224"
                           MaxHeight="480"
                           FontFamily="Consolas"
                           FontSize="12"
                           Text="No snapshot loaded."
                           TextWrapping="NoWrap"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="Diagnostic archive"
                                           Description="Save a support-ready copy of the current Core state and recent local logs. The ZIP may include hardware and configuration details.">
                  <ui:FASettingsExpanderItem.Footer>
                    <Button x:Name="ExportDiagnosticsButton"
                            Content="Export ZIP"
                            IsEnabled="False"
                            Click="ExportDiagnosticsClick" />
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
              </ui:FASettingsExpander>

              <ui:FASettingsExpander x:Name="DeviceDebugExpander"
                                     Theme="{StaticResource THRMSettingsExpanderTheme}"
                                     Header="Device command"
                                     Description="Advanced support tool."
                                     IsExpanded="False"
                                     IsEnabled="False">
                <ui:FASettingsExpander.IconSource>
                  <icons:FluentIconSource Icon="DeveloperBoard" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpanderItem Padding="0"
                                           MinHeight="0"
                                           Background="Transparent"
                                           HorizontalContentAlignment="Stretch">
                  <ui:FASettingsExpanderItem.Resources>
                    <Thickness x:Key="SettingsExpanderItemContentMargin">0</Thickness>
                  </ui:FASettingsExpanderItem.Resources>
                  <ui:FAInfoBar HorizontalAlignment="Stretch"
                                IsOpen="True"
                                IsClosable="False"
                                Severity="Warning"
                                Title="Firmware commands"
                                Message="Send only a command supplied by THRM support; it is written directly to the connected device." />
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem x:Name="DeviceDebugCommandSetting"
                                           Classes="last-visible-setting"
                                           Content="Hex command"
                                           Description="Enable diagnostic logging first.">
                  <ui:FASettingsExpanderItem.Footer>
                    <Grid ColumnDefinitions="220,Auto" ColumnSpacing="8">
                      <TextBox x:Name="DeviceDebugCommandTextBox"
                               Grid.Column="0"
                               IsEnabled="False"
                               FontFamily="Consolas"
                               PlaceholderText="27 or 5A A5 27 02 29"
                               AutomationProperties.Name="Device firmware command" />
                      <Button x:Name="SendDeviceDebugCommandButton"
                              Grid.Column="1"
                              Classes="accent"
                              Content="Send"
                              IsEnabled="False"
                              Click="SendDeviceDebugCommandClick" />
                    </Grid>
                  </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem x:Name="DeviceDebugResultSetting"
                                           IsVisible="False">
                  <TextBox x:Name="DeviceDebugResultTextBox"
                           AcceptsReturn="True"
                           IsReadOnly="True"
                           MinHeight="120"
                           MaxHeight="320"
                           FontFamily="Consolas"
                           FontSize="12"
                           TextWrapping="NoWrap"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                </ui:FASettingsExpanderItem>
              </ui:FASettingsExpander>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer x:Name="AboutPage"
                        Classes="page-scroll"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24" Spacing="16">
              <StackPanel Spacing="4">
                <TextBlock Text="About" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="This client is a migrated Avalonia IPC slice for THRM Core."
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>

              <ui:FASettingsExpander Theme="{StaticResource THRMSettingsExpanderTheme}"
                                     Header="Migration scope"
                                     Description="Current Avalonia coverage and remaining legacy features."
                                     IsExpanded="True">
                <ui:FASettingsExpander.IconSource>
                  <icons:FluentIconSource Icon="Info" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpanderItem Description="Migrated IPC slice.">
                  <TextBlock Text="Connection, fan curve editing, temperature history, fan control, device settings, diagnostics, RTSS overlay, monitoring source selection, and Core actions."
                             TextWrapping="Wrap" />
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Description="Remaining legacy feature.">
                  <TextBlock Text="Noise calibration remains in the legacy Wails frontend."
                             TextWrapping="Wrap" />
                </ui:FASettingsExpanderItem>
              </ui:FASettingsExpander>
            </StackPanel>
          </ScrollViewer>
          </Grid>
        </Grid>
      </ui:FANavigationView.Content>
    </ui:FANavigationView>

  </Grid>
</Window>
