<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="THRM.Avalonia.MainWindow"
        Title="THRM Avalonia POC"
        Width="900"
        Height="620"
        MinWidth="720"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="PageBrush" Color="#111318" />
    <SolidColorBrush x:Key="CardBrush" Color="#1B1F27" />
    <SolidColorBrush x:Key="MutedBrush" Color="#A9B1C0" />
    <SolidColorBrush x:Key="AccentBrush" Color="#6EA8FE" />
  </Window.Resources>

  <Grid Background="{DynamicResource PageBrush}" RowDefinitions="Auto,*,Auto">
    <Border Padding="28,24,28,16">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="THRM" FontSize="28" FontWeight="Bold" />
          <TextBlock Text="Avalonia vertical slice" Foreground="{DynamicResource MutedBrush}" />
        </StackPanel>
        <Border Grid.Column="1" Padding="12,7" CornerRadius="16" Background="{DynamicResource CardBrush}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse x:Name="ConnectionDot" Width="10" Height="10" Fill="#F59E0B" VerticalAlignment="Center" />
            <TextBlock x:Name="ConnectionText" Text="Connecting" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" Padding="28,4,28,20">
      <StackPanel Spacing="16">
        <Grid ColumnDefinitions="*,16,*">
          <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20">
            <StackPanel Spacing="10">
              <TextBlock Text="Device" FontSize="18" FontWeight="SemiBold" />
              <TextBlock x:Name="DeviceText" Text="Disconnected" FontSize="24" FontWeight="Bold" />
              <TextBlock x:Name="ModelText" Text="Model —" Foreground="{DynamicResource MutedBrush}" />
              <TextBlock x:Name="ProductText" Text="Product ID —" Foreground="{DynamicResource MutedBrush}" />
              <TextBlock x:Name="ModeText" Text="Mode —" Foreground="{DynamicResource MutedBrush}" />
              <TextBlock x:Name="FanText" Text="Fan —" Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20">
            <StackPanel Spacing="10">
              <TextBlock Text="Temperature" FontSize="18" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                <TextBlock Text="CPU" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Grid.Column="1" x:Name="CpuTempText" Text="—" HorizontalAlignment="Right" FontSize="22" FontWeight="Bold" />
                <TextBlock Grid.Row="1" Text="GPU" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="GpuTempText" Text="—" HorizontalAlignment="Right" FontSize="22" FontWeight="Bold" />
                <TextBlock Grid.Row="2" Text="Max" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="MaxTempText" Text="—" HorizontalAlignment="Right" FontSize="22" FontWeight="Bold" />
              </Grid>
              <TextBlock x:Name="BridgeText" Text="Temperature bridge —" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>

        <Grid ColumnDefinitions="*,16,*">
          <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20">
            <StackPanel Spacing="10">
              <TextBlock Text="Core configuration" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="Choose whether THRM Core manages the device automatically." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ToggleSwitch x:Name="AutoControlSwitch" Content="Auto control" IsEnabled="False" Click="AutoControlClick" />
                <TextBlock x:Name="AutoControlText" Text="—" VerticalAlignment="Center" />
              </StackPanel>
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto" RowSpacing="10">
                <TextBlock Text="Protocol" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Grid.Column="1" Text="3.0 JSON-lines" HorizontalAlignment="Right" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20">
            <StackPanel Spacing="10">
              <TextBlock Text="IPC actions" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="Device commands are available after a synchronized device state." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ConnectDeviceButton" Content="Connect device" Click="ConnectDeviceClick" IsEnabled="False" />
                <Button x:Name="DisconnectDeviceButton" Content="Disconnect device" Click="DisconnectDeviceClick" IsEnabled="False" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Refresh" Click="RefreshClick" />
                <Button Content="Show window" Click="ShowWindowClick" />
                <Button Content="Quit core" Click="QuitCoreClick" />
              </StackPanel>
              <TextBlock x:Name="StatusText" Text="Waiting for THRM Core" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Padding="28,10" Background="{DynamicResource CardBrush}">
      <TextBlock x:Name="LastUpdateText" Text="No state received" Foreground="{DynamicResource MutedBrush}" />
    </Border>
  </Grid>
</Window>
